# ── Helius (get a free key at helius.dev) ──────────────────────────────────────
HELIUS_API_KEY=

# ── Leaderboard URL (discover via browser DevTools on phantom.app/leaderboard) ─
# Leave blank to auto-try known endpoints
LEADERBOARD_URL=

# ── Paper trading (safe default — set to false only when going live) ───────────
PAPER_TRADING=true
PAPER_BALANCE=1000

# ── Copy-trade decision rules ──────────────────────────────────────────────────
MIN_WIN_RATE=0.60          # wallet must win ≥60% of trades
MIN_ROI_RATE=0.90          # ≥90% of trades must exceed MIN_ROI_THRESHOLD
MIN_ROI_THRESHOLD=30       # ROI % each qualifying trade must beat
MAX_LOSS_DURATION_MIN=180  # wallets that hold losing trades >3h are excluded

# ── Risk limits per copy trade ─────────────────────────────────────────────────
MAX_POSITION_USD=100
MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=3
COPY_COOLDOWN_SEC=300

# ── Webhook (required for real-time alerts; needs a public URL) ────────────────
WEBHOOK_URL=https://YOUR_SERVER/webhook
WEBHOOK_SECRET=change_me

# ── Dashboard ──────────────────────────────────────────────────────────────────
DASHBOARD_PORT=5001

# ── Live trading only (leave blank in paper mode) ─────────────────────────────
WALLET_PRIVATE_KEY=
