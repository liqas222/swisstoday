ANTHROPIC_API_KEY=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
DRY_RUN=true
CHECK_INTERVAL_MINUTES=15
CLAUDE_MODEL=claude-haiku-4-5-20251001
DB_PATH=swissintel.db
LOG_LEVEL=INFO
# Auto-deploy: bot pulls new commits from its branch and restarts itself.
# Set to false to disable and deploy manually.
AUTO_UPDATE=true
# How often to check GitHub, in minutes. Only a tiny git fetch, no API cost.
# Lower = urgent fixes land faster; 60 or more is fine if you deploy rarely.
AUTO_UPDATE_INTERVAL_MINUTES=15
# Minimum viral_score (1-100) an item needs to be posted at all. 0 = post everything.
POST_MIN_SCORE=60
